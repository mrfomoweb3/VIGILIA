# Otari gateway (otari.ai) — every model call goes through it.
OTARI_API_KEY=
OTARI_BASE_URL=https://api.otari.ai/api/v1
# Model roles (open-weight). Each is "provider:model" or an Otari routing policy name.
OTARI_VISION_MODEL=groq:meta-llama/llama-4-scout-17b-16e-instruct
# Verdict uses the routing policy created by `npm run otari:setup`.
OTARI_VERDICT_MODEL=vigilia-verdict
OTARI_INVESTIGATOR_MODEL=groq:qwen/qwen3-32b
# Models inside the vigilia-verdict policy (all open-weight).
OTARI_VERDICT_PRIMARY=groq:openai/gpt-oss-120b
OTARI_VERDICT_THRIFTY=groq:openai/gpt-oss-20b
OTARI_VERDICT_FALLBACK=together:meta-llama/Llama-3.3-70B-Instruct-Turbo
# Needed only for `npm run otari:setup` to save the policy over the API.
OTARI_WORKSPACE_ID=
# Prompt-injection guardrail profile used on the page-inspection call.
OTARI_GUARDRAIL_PROFILE=prompt-injection
# Otari calls Vigilia's checkers at PUBLIC_BASE_URL/mcp with this bearer token.
PUBLIC_BASE_URL=
VIGILIA_MCP_TOKEN=
# Salt for pseudonymous end-user ids sent to Otari (per-user budgets).
END_USER_SALT=

# Google Safe Browsing API v4 key — the deterministic backbone
GOOGLE_SAFE_BROWSING_API_KEY=

# Optional WHOIS API fallback (only if local whoiser lookups prove unreliable)
WHOIS_API_KEY=

# Server
PORT=3000

# Price per check, in USD. The OKX SDK auto-converts to the network stablecoin.
PRICE_PER_CHECK_USDT=0.2

# ---- x402 payment (official OKX Payment seller SDK) -------------------------
# /api/check is gated by @okxweb3/x402-express. These must be set in production
# for the SDK to verify + settle payments through the OKX facilitator (Broker).

# CAIP-2 network: eip155:196 = X Layer mainnet, eip155:1952 = X Layer testnet.
X402_NETWORK=eip155:196

# Wallet that receives payment (the agent's owner address). Falls back to
# WALLET_ADDRESS if unset.
X402_PAYTO_ADDRESS=
WALLET_ADDRESS=

# OKX facilitator credentials — apply at the OKX Developer Portal.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=

# Website-only flag surfaced at /api/config (does not gate /api/check).
PAYMENTS_ENABLED=false

# ---- Cost guardrails --------------------------------------------------------
# Haiku 4.5 pricing: $1.00 / 1M input tokens, $5.00 / 1M output tokens.
# Rough cost per check: ~$0.0013 text, ~$0.007 screenshot (vision).

# Master kill switch. false = no Anthropic calls at all; the pipeline still
# returns deterministic verdicts from the security checks.
LLM_ENABLED=true

# Screenshot/vision costs ~5x a text check. Turn off to save budget.
VISION_ENABLED=true

# Spend is capped in Otari (key ceiling + per-end-user budgets), not here.
# Local hard ceiling on model calls per UTC day, as a last line of defense.
MAX_LLM_CALLS_PER_DAY=300

# Per-IP cap on /api/check per hour — the main abuse defense once deployed.
MAX_CHECKS_PER_HOUR_PER_IP=15
